  <name lang="en-GB" default="true">The Dream Islander Wig</name>
  <name lang="fr-FR" default="false">L'indigène de l’île de Rêve</name>
  <name lang="de-DE" default="false">Der Trauminseltyp</name>
  <name lang="it-IT" default="false">L'Isolano da Sogno</name>
